# Copy to .env and change every secret before first start.
#   cp .env.example .env

# Live Brodansh instance (Odoo 18 Enterprise)
ODOO_VERSION=18.0
POSTGRES_VERSION=16
ODOO_IMAGE=odoo:18.0

POSTGRES_USER=odoo
POSTGRES_PASSWORD=change-this-strong-db-password
POSTGRES_DB=postgres

# Master password for /web/database/manager
ODOO_ADMIN_PASSWORD=change-this-master-password

# Smoke-test database name only. Live 1 has four databases; Live 2 must
# restore all of them from a read-only dump (do not pin dbfilter).
ODOO_DB_NAME=brodansh
LIVE_ODOO_DBS=brodan,brodan2026,brodansh,test

# Bind Odoo only on localhost in production (nginx in front).
# Use 0.0.0.0 for a first smoke test without nginx.
ODOO_BIND=127.0.0.1
ODOO_HTTP_PORT=8069
ODOO_GEVENT_PORT=8072
ODOO_CONF_FILE=odoo.conf.runtime

# Public URL of Live 2 — subdomain next to the shop, never the apex shop
# and never Live 1 (brodansh.de.com.eg).
ODOO_DOMAIN=odoo.zouljanaheen.com
LETSENCRYPT_EMAIL=admin@zouljanaheen.com

# Live 1 (DO NOT CHANGE — AWS production). Scripts refuse writes here.
LIVE1_URL=https://brodansh.de.com.eg
LIVE1_DOMAIN=brodansh.de.com.eg
LIVE1_IP=18.133.13.149
LIVE_URL=https://brodansh.de.com.eg
# Existing hosts that must not be overwritten:
# Live 1 AWS, the other AWS Odoo, and the Bagisto shop at zouljanaheen.com
PROTECTED_IPS=18.133.13.149,3.8.46.165,46.101.110.51
PROTECTED_DOMAINS=brodansh.de.com.eg,www.brodansh.de.com.eg,zouljanaheen.com,www.zouljanaheen.com
# Optional: only if YOU run a read-only dump over SSH. Prefer copying a dump file instead.
LIVE_SSH_HOST=
LIVE_SSH_USER=ubuntu
LIVE_SSH_PORT=22
LIVE_ODOO_DB=brodansh
LIVE_FILESTORE=/var/lib/odoo/.local/share/Odoo/filestore
LIVE_ENTERPRISE=/opt/odoo/enterprise
LIVE_CUSTOM_ADDONS=/opt/odoo/custom-addons

# Live 2 destination (Hetzner CX33) — separate from Live 1
HETZNER_SSH=root@CX33_IP

# Locked VPS for Live 2: Hetzner CX33, Falkenstein then Nuremberg
HCLOUD_SERVER_NAME=brodansh-live2
HCLOUD_SERVER_TYPE=cx33
HCLOUD_IMAGE=ubuntu-24.04
HCLOUD_LOCATION=fsn1
HCLOUD_FALLBACK_LOCATION=nbg1
# HCLOUD_SSH_KEY=your-key-name
# Export HCLOUD_TOKEN in the shell; do not commit it.
