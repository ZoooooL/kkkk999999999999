# Copy to .env next to docker-compose.yml. Do not commit .env.

DEST=onedrive
PGHOST=host.docker.internal
PGPORT=5432
PGUSER=odoo
PGPASSWORD=
PGDATABASE=brodansh

# OneDrive personal folder. Token JSON is the rclone onedrive token object.
ONEDRIVE_FOLDER=Brodansh_Backups
ONEDRIVE_TOKEN_JSON=
ONEDRIVE_DRIVE_ID=
ONEDRIVE_DRIVE_TYPE=personal

# Windows PC via Tailscale userspace SOCKS. Requires DEST=sftp and TS_AUTHKEY.
SFTP_HOST=100.78.222.34
SFTP_USER=lenovo
SFTP_PASSWORD=
SFTP_PATH=/D:/Zool Sulotion
TS_AUTHKEY=
TS_HOSTNAME=brodan-backup
TAILSCALE_WAIT_SECS=90
RCLONE_SOCKS=127.0.0.1:1055
RCLONE_CONFIG=/var/lib/rclone/rclone.conf
