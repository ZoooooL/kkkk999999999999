<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_brodan_backup" model="ir.cron">
        <field name="name">BRODAN: نسخة احتياطية يومية</field>
        <field name="model_id" ref="model_brodan_backup_config"/>
        <field name="state">code</field>
        <field name="code">model.cron_run()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
        <field name="groups_id" eval="[(4, ref('group_backup_owner'))]"/>
    </record>
</odoo>
