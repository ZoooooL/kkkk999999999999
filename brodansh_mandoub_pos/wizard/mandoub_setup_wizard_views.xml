<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_brodansh_mandoub_setup_wizard_form" model="ir.ui.view">
        <field name="name">brodansh.mandoub.setup.wizard.form</field>
        <field name="model">brodansh.mandoub.setup.wizard</field>
        <field name="arch" type="xml">
            <form string="تهيئة جلسات المناديب">
                <group>
                    <field name="company_id"/>
                    <field name="note" nolabel="1" colspan="2" placeholder="ستظهر نتيجة التهيئة هنا بعد التنفيذ."/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="تطبيق التهيئة" class="btn-primary"/>
                    <button string="إغلاق" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_brodansh_mandoub_setup_wizard" model="ir.actions.act_window">
        <field name="name">تهيئة جلسات المناديب</field>
        <field name="res_model">brodansh.mandoub.setup.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_brodansh_mandoub_setup"
        name="تهيئة جلسات المناديب"
        parent="point_of_sale.menu_point_config_product"
        action="action_brodansh_mandoub_setup_wizard"
        sequence="90"
    />
</odoo>
