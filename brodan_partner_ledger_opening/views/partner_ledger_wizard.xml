<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="field_account_report_partner_ledger_x_show_opening_balance" model="ir.model.fields">
        <field name="name">x_show_opening_balance</field>
        <field name="field_description">إظهار الرصيد الافتتاحي</field>
        <field name="help">يعرض صف الرصيد قبل تاريخ البداية ويُضاف إلى الرصيد الجاري.</field>
        <field name="model">account.report.partner.ledger</field>
        <field name="model_id" ref="accounting_pdf_reports.model_account_report_partner_ledger"/>
        <field name="ttype">boolean</field>
        <field name="state">manual</field>
        <field name="copied" eval="True"/>
        <field name="store" eval="True"/>
    </record>

    <record id="accounting_pdf_reports_account_report_partner_ledger_view" model="ir.ui.view">
        <field name="name">account.report.partner.ledger.form.opening.balance</field>
        <field name="model">account.report.partner.ledger</field>
        <field name="inherit_id" ref="accounting_pdf_reports.account_report_partner_ledger_view"/>
        <field name="arch" type="xml">
            <field name="date_from" position="before">
                <field name="x_show_opening_balance"/>
            </field>
        </field>
    </record>
</odoo>
