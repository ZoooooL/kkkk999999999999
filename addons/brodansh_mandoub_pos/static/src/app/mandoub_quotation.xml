<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="brodansh_mandoub_pos.ProductScreen" t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension">
        <xpath expr="//ActionpadWidget" position="attributes">
            <attribute name="actionName">mandoubPaymentLabel</attribute>
        </xpath>
        <xpath expr="//button[hasclass('pay-button')]/span[1]" position="replace">
            <span class="d-block" t-esc="mandoubPayLabel"/>
        </xpath>
    </t>
</templates>
