# Copy to .env and change every secret before first start.
#   cp .env.example .env

# Live Brodansh instance (Odoo 18 Enterprise)
ODOO_VERSION=18.0
POSTGRES_VERSION=16
ODOO_IMAGE=odoo:18.0

POSTGRES_USER=odoo
POSTGRES_PASSWORD=change-this-strong-db-password
POSTGRES_DB=postgres

# Master password for /web/database/manager
ODOO_ADMIN_PASSWORD=change-this-master-password

# Database name after restore / first create
ODOO_DB_NAME=brodansh

# Bind Odoo only on localhost in production (nginx in front).
# Use 0.0.0.0 for a first smoke test without nginx.
ODOO_BIND=127.0.0.1
ODOO_HTTP_PORT=8069
ODOO_GEVENT_PORT=8072
ODOO_CONF_FILE=odoo.conf.runtime

# Public URL after DNS points at the new server
ODOO_DOMAIN=brodansh.de.com.eg
LETSENCRYPT_EMAIL=admin@brodansh.de.com.eg

# Source live server (current AWS London host of brodansh.de.com.eg)
LIVE_URL=https://brodansh.de.com.eg
LIVE_SSH_HOST=18.133.13.149
LIVE_SSH_USER=ubuntu
LIVE_SSH_PORT=22
LIVE_ODOO_DB=brodansh
# Paths on the live Ubuntu host (adjust after you inspect the server)
LIVE_FILESTORE=/var/lib/odoo/.local/share/Odoo/filestore
LIVE_ENTERPRISE=/opt/odoo/enterprise
LIVE_CUSTOM_ADDONS=/opt/odoo/custom-addons

# Destination Hetzner CX33 after you create it
HETZNER_SSH=root@CX33_IP

# Locked VPS: Hetzner CX33, Falkenstein then Nuremberg
HCLOUD_SERVER_NAME=brodansh-odoo
HCLOUD_SERVER_TYPE=cx33
HCLOUD_IMAGE=ubuntu-24.04
HCLOUD_LOCATION=fsn1
HCLOUD_FALLBACK_LOCATION=nbg1
# HCLOUD_SSH_KEY=your-key-name
# Export HCLOUD_TOKEN in the shell; do not commit it.
